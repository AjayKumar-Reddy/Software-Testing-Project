{
  "name": "facultyhub-backend",
  "version": "1.0.0",
  "description": "FacultyHub REST API (Express + MongoDB)",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "seed": "tsx src/scripts/seed.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify:seed": "tsx src/scripts/verify-seed.ts"
  },
  "keywords": [],
