# ---- Server ----
NODE_ENV=development
PORT=5050
# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:3000

# ---- Database ----
MONGO_URI=mongodb://127.0.0.1:27017/facultyhub
# Used by `npm test` (the database is wiped by the tests)
MONGO_URI_TEST=mongodb://127.0.0.1:27017/facultyhub_test

# ---- Auth (CHANGE THESE IN PRODUCTION) ----
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_EXPIRES=15m
REFRESH_TOKEN_DAYS=7

# ---- Email (optional) ----
# Leave SMTP_HOST empty to log emails to the console instead of sending them.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="FacultyHub <no-reply@facultyhub.local>"

# ---- Seeding (development only) ----
SEED_DEMO_PASSWORD=Demo@123
